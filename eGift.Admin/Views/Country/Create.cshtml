@model CountryViewModel

@{
    ViewData["Title"] = "Create Country";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Create Country</h2>

        <a asp-action="Index" class="btn btn-secondary">
            Back to List
        </a>

    </div>

    <div class="card">

        <div class="card-header">
            <h5 class="mb-0">
                Country Information
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- Country Code -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="CountryCode" class="form-label">
                        </label>

                        <input asp-for="CountryCode" class="form-control" placeholder="Enter country code" />

                        <span asp-validation-for="CountryCode" class="text-danger">
                        </span>

                    </div>

                    <!-- Country Name -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="CountryName" class="form-label">
                        </label>

                        <input asp-for="CountryName" class="form-control" placeholder="Enter country name" />

                        <span asp-validation-for="CountryName" class="text-danger">
                        </span>

                    </div>

                    <!-- Description -->
                    <div class="col-12 mb-3">

                        <label asp-for="Description" class="form-label">
                        </label>

                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Enter country description"></textarea>

                        <span asp-validation-for="Description" class="text-danger">
                        </span>

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Create Country
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}