@using eGift.Admin.Common
@using eGift.Admin.Helpers
@model OrderListViewModel

@{
    ViewData["Title"] = "Orders";
}

<link rel="stylesheet" href="~/css/order.css" asp-append-version="true" />

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 egift-page-header">
        <div>
            <h2 class="mb-1">
                Orders
            </h2>

            <p class="mb-0">
                @(Model?.OrderList?.Count() ?? 0)
                order@(Model?.OrderList?.Count() == 1 ? "" : "s") total
            </p>
        </div>      
    </div>


    @if (Model != null &&
         Model.OrderList != null &&
         Model.OrderList.Any())
    {
        <div class="card egift-card">
            <div class="table-responsive egift-table-scroll">
                <table class="table egift-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width:50px;">
                                #
                            </th>

                            <th>
                                Order Number
                            </th>

                            <th>
                                Customer
                            </th>

                            <th>
                                Total Amount
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Created
                            </th>

                            <th class="text-center pe-4">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int count = 1;
                        }
                        @foreach (var order in Model.OrderList)
                        {
                            <tr>
                                <!-- # -->
                                <td class="ps-4 egift-sub">
                                    @count
                                </td>

                                <!-- Order Number -->
                                <td>
                                    <div class="egift-name">
                                        @order.OrderNumber
                                    </div>
                                </td>

                                <!-- Customer -->
                                <td>
                                    <div class="egift-name">
                                        @(string.IsNullOrWhiteSpace(order.CustomerName)
                                            ? "—"
                                            : order.CustomerName)
                                    </div>
                                </td>

                                <!-- Total Amount -->
                                <td>
                                    <div class="egift-name">
                                        ₹@order.TotalAmount.ToString("0.00")
                                    </div>
                                </td>

                                <!-- Status -->
                                <td>
                                    @{var status = (OrderStatus)order.StatusId;}
                                    <span class="badge-egift-status badge-egift-@status.ToString().ToLower()">@status</span>
                                </td>

                                <!-- Created -->
                                <td class="egift-sub">
                                    @order.CreatedDate.ToDateString()
                                </td>

                                <!-- Actions -->

                                <td class="text-center pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info"
                                           title="Details">
                                            Details
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->

        <div class="card egift-card">

            <div class="card-body text-center py-5">

                <div class="egift-empty-icon">

                    <i class="bi bi-receipt"></i>

                </div>


                <h5 class="mb-1 fw-bold" style="color:var(--egift-text-dark);">

                    No orders found

                </h5>


                <p class="egift-sub mb-3">

                    Get started by adding your first order.

                </p>


                <a asp-action="Create" class="btn btn-egift-primary">

                    <i class="bi bi-plus-circle me-1"></i>
                    Add Order

                </a>

            </div>

        </div>
    }

</div>