@using eGift.Admin.Helpers
@model AddressListViewModel

@{
    ViewData["Title"] = "Addresses";
}

<link rel="stylesheet" href="~/css/address.css" asp-append-version="true" />

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 egift-page-header">

        <div>
            <h2 class="mb-1">Addresses</h2>

            <p class="mb-0">
                @(Model?.AddressList?.Count() ?? 0)
                address@(Model?.AddressList?.Count() == 1 ? "" : "es")
                total
            </p>
        </div>

        <a asp-action="Create" class="btn btn-egift-primary d-flex align-items-center gap-2">

            <i class="bi bi-plus-circle"></i>
            Add Address

        </a>

    </div>


    @if (Model != null &&
         Model.AddressList != null &&
         Model.AddressList.Any())
    {
        <div class="card egift-card">

            <div class="table-responsive egift-table-scroll">

                <table class="table egift-table mb-0">

                    <thead>

                        <tr>

                            <th class="ps-4" style="width:50px;">
                                #
                            </th>

                            <th>
                                Street
                            </th>

                            <th>
                                Country
                            </th>

                            <th>
                                State
                            </th>

                            <th>
                                City
                            </th>

                            <th>
                                Pin Code
                            </th>

                            <th>
                                Created
                            </th>

                            <th class="text-center pe-4">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int count = 1;
                        }

                        @foreach (var address in Model.AddressList)
                        {
                            <tr>

                                <!-- Number -->
                                <td class="ps-4 egift-sub">
                                    @count
                                </td>


                                <!-- Street -->
                                <td>

                                    <div class="egift-name">
                                        @address.Street1
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(address.Street2))
                                    {
                                        <div class="egift-sub">
                                            @address.Street2
                                        </div>
                                    }

                                </td>


                                <!-- Country -->
                                <td>
                                    @address.CountryName
                                </td>


                                <!-- State -->
                                <td>
                                    @address.StateName
                                </td>


                                <!-- City -->
                                <td>
                                    @address.CityName
                                </td>


                                <!-- Pin Code -->
                                <td>
                                    @address.PinCode
                                </td>


                                <!-- Created -->
                                <td class="egift-sub">

                                    @address.CreatedDate.ToDateString()

                                </td>


                                <!-- Actions -->
                                <td class="text-center pe-4">

                                    <div class="btn-group" role="group">

                                        <a asp-action="Details" asp-route-id="@address.Id" class="btn btn-sm btn-outline-info"
                                           title="Details">
                                            Details
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@address.Id" class="btn btn-sm btn-outline-primary"
                                           title="Edit">
                                            Edit
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@address.Id" method="post"
                                        class="d-inline delete-form" data-delete-name="city">

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                            count++;
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="card egift-card">

            <div class="card-body text-center py-5">

                <div class="egift-empty-icon">

                    <i class="bi bi-geo-alt"></i>

                </div>

                <h5 class="mb-1 fw-bold" style="color:var(--egift-text-dark);">
                    No addresses found
                </h5>

                <p class="egift-sub mb-3">
                    Get started by adding your first address.
                </p>

                <a asp-action="Create" class="btn btn-egift-primary">

                    <i class="bi bi-plus-circle me-1"></i>
                    Add Address

                </a>

            </div>

        </div>
    }

</div>