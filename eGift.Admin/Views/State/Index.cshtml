@using eGift.Admin.Helpers
@model StateListViewModel

@{
    ViewData["Title"] = "States";
}

<link rel="stylesheet" href="~/css/state.css" asp-append-version="true" />

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 egift-page-header">

        <div>
            <h2 class="mb-1">States</h2>

            <p class="mb-0">
                @(Model?.StateList?.Count() ?? 0)
                @(Model?.StateList?.Count() == 1 ? "state" : "states") total
            </p>
        </div>

        <a asp-action="Create" class="btn btn-egift-primary d-flex align-items-center gap-2">

            <i class="bi bi-plus-circle"></i>
            Add State

        </a>

    </div>

    @if (Model != null &&
         Model.StateList != null &&
         Model.StateList.Any())
    {
        <div class="card egift-card">

            <div class="table-responsive egift-table-scroll">

                <table class="table egift-table mb-0">

                    <thead>
                        <tr>

                            <th class="ps-4" style="width:50px;">
                                #
                            </th>

                            <th>
                                State Code
                            </th>

                            <th>
                                State Name
                            </th>

                            <th>
                                Country
                            </th>

                            <th>
                                Created
                            </th>

                            <th class="text-center pe-4">
                                Actions
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int count = 1;
                        }

                        @foreach (var state in Model.StateList)
                        {
                            <tr>

                                <td class="ps-4 egift-sub">
                                    @count
                                </td>

                                <td>
                                    <div class="egift-name">
                                        @state.StateCode
                                    </div>
                                </td>

                                <td>
                                    <div class="egift-name">
                                        @state.StateName
                                    </div>
                                </td>

                                <td>
                                    @state.CountryName
                                </td>

                                

                                <td class="egift-sub">
                                    @state.CreatedDate.ToDateString()
                                </td>

                                <!-- Actions -->
                                <td class="text-center pe-4">

                                    <div class="btn-group" role="group">

                                        <a asp-action="Details" asp-route-id="@state.Id" class="btn btn-sm btn-outline-info"
                                           title="Details">
                                            Details
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@state.Id" class="btn btn-sm btn-outline-primary"
                                           title="Edit">
                                            Edit
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@state.Id" method="post"
                                              class="d-inline delete-form" data-delete-name="state"
                                              >

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                            count++;
                        }

                    </tbody>

                </table>

            </div>
        </div>
    }
    else
    {
        <div class="card egift-card">

            <div class="card-body text-center py-5">

                <div class="egift-empty-icon">
                    <i class="bi bi-map"></i>
                </div>

                <h5 class="mb-1 fw-bold" style="color:var(--egift-text-dark);">
                    No states found
                </h5>

                <p class="egift-sub mb-3">
                    Get started by adding your first state.
                </p>

                <a asp-action="Create" class="btn btn-egift-primary">

                    <i class="bi bi-plus-circle me-1"></i>
                    Add State

                </a>

            </div>
        </div>
    }

</div>