@model List<ProductResponseViewModel>;
@{
    ViewData["Title"] = "Home Page";
    var webApiUrl = Configuration["WebAPIUrl"];
    var userName = Context.Session.GetString("UserName");

    
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="container">

    @if (Model == null)
    {
        <div class="card egift-card">
            <div class="card-body text-center py-5">
                <div class="egift-empty-icon"><i class="bi bi-tags"></i></div>

                <h5 class="mb-1 fw-bold" style="color:var(--egift-text-dark);">
                    No product found
                </h5>
            </div>
        </div>
    }
    else
    {
        <div class="product-grid">

            @foreach (var product in Model)
            {
                <div class="product-card">

                    <!-- Product Image -->
                    <div class="product-image-container">
                        @if (!string.IsNullOrEmpty(product.ProductImagePath))
                        {
                            <img src="@Url.Action(
                                                         "Image",
                                                         "Home",
                                                         new
                                                         {
                                                             fileName = System.IO.Path.GetFileName(product.ProductImagePath)
                                                         })" alt="@product.Name" class="product-image" />
                        }
                        else
                        {
                            <div class="product-image-placeholder">
                                <i class="bi bi-image"></i>
                                <span>No image</span>
                            </div>
                        }

                    </div>

                    <!-- Product Information -->
                    <div class="product-content">

                        <h3 class="product-name">
                            <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.Id">
                                @product.Name
                            </a>
                        </h3>

                        <p class="product-description">@product.ShortDescription</p>

                        <div class="product-bottom">

                            <div class="product-price">₹@product.UnitPrice.ToString("N2")
                            </div>

                            @if (!string.IsNullOrEmpty(userName))
                            {
                                <button type="button" class="add-to-cart" data-product-id="@product.Id"
                                        onclick="event.stopPropagation();">
                                    <i class="bi bi-cart-plus"></i>
                                    Add to Cart
                                </button>
                            }
                            else
                            {
                                <button type="button" class="add-to-cart-login" data-bs-toggle="modal" data-bs-target="#loginModal" onclick="event.stopPropagation();">

                                    <i class="bi bi-cart-plus"></i>Add to Cart
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        }
    </div>

    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="loginModalLabel">
                        Login
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    </button>
                </div>

                <form id="loginForm" asp-controller="Account" asp-action="PopupLogin" method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-body">

                        <!-- Login Error -->
                        <div id="loginError" class="alert alert-danger" style="display:none;">
                        </div>

                        <div class="mb-3">
                            <label for="UserName" class="form-label">Username</label>

                            <input type="text" id="UserName" name="UserName" class="form-control"
                                   placeholder="Enter username" required />
                        </div>

                        <div class="mb-3">
                            <label for="Password" class="form-label">Password</label>
                            <input type="password" id="Password" name="Password" class="form-control"
                                   placeholder="Enter password" required />
                        </div>

                        <div class="form-check">
                            <input type="checkbox" id="RememberMe" name="RememberMe" value="true"
                                   class="form-check-input" />
                            <label for="RememberMe" class="form-check-label">Remember me</label>
                        </div>
                    </div>

                    <div class="modal-footer">

                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" id="loginButton" class="btn btn-primary">
                            Login
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
        <script src="~/js/login.js" asp-append-version="true"></script>
    <script src="~/js/mycart.js" asp-append-version="true"></script>
    }