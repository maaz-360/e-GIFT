@{
    string ApplicationName = "eGift.Store";
    int inceptionYear = 2026;
    int currentYear = DateTime.Now.Year;
    bool isSameYear = inceptionYear == currentYear;
    var userName = Context.Session.GetString("UserName");
    
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @ApplicationName</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/eGift.Store.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />

</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">@ApplicationName</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (!string.IsNullOrEmpty(userName))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="MyCart" asp-action="Index">My
                                    Cart</a>
                                </li>
                                @* <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Order"
                                       asp-action="Checkout">Checkout</a>
                                </li> *@
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Order" asp-action="MyOrder">My
                                        Orders</a>
                                    </li>
                                }
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                                       asp-action="Privacy">Privacy</a>
                                </li>
                            </ul>
                            <!-- Right side -->
                            <ul class="navbar-nav ms-auto align-items-center">
                                @if (!string.IsNullOrEmpty(userName))
                                {
                                    <li class="nav-item">
                                        <span class="nav-link text-gray">
                                            Welcome <span class="fw-bold">@userName</span>!
                                        </span>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Customer"
                                           asp-action="MyProfile">My Profile</a>
                                    </li>

                                    <li class="nav-item">
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">

                                            <button type="submit" class="btn btn-link nav-link text-gray fw-bold">
                                                Logout
                                            </button>

                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Account"
                                           asp-action="Register">Register</a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Account"
                                           asp-action="Login">Login</a>
                                    </li>
                                }

                            </ul>
                        </div>
                    </div>
                </nav>
            </header>
            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer text-muted">
                <div class="container">
                    &copy; @(isSameYear ? currentYear : inceptionYear + "-" + currentYear) - @ApplicationName
                </div>
            </footer>
            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            <script src="~/js/site.js" asp-append-version="true"></script>
            <!-- Toastr -->
            <script src="~/lib/toastr/toastr.min.js"></script>
            <!-- SweetAlert2 -->
            <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
            @if (TempData["ToastrMessage"] != null)
            {
                <script>
                    $(document).ready(function () {

                    var message = '@TempData["ToastrMessage"]';
                    var type = '@TempData["ToastrType"]';

                    toastr[type.toLowerCase()](message);

                    });
                </script>
            }
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>
