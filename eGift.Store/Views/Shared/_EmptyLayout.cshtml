@{
    string ApplicationName = "eGift.Store";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @ApplicationName</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/eGift.Store.styles.css"
          asp-append-version="true" />

    <!-- Toastr -->
    <link rel="stylesheet"
          href="~/lib/toastr/toastr.min.css" />

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    @RenderBody()


    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Site JS -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- Toastr -->
    <script src="~/lib/toastr/toastr.min.js"></script>


    @if (TempData["ToastrMessage"] != null)
    {
        <script>
            $(document).ready(function () {

                var message = '@TempData["ToastrMessage"]';
                var type = '@TempData["ToastrType"]';

                toastr[type.toLowerCase()](message);

            });
        </script>
    }


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>